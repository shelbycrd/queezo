# Local gateway binds to 127.0.0.1. Change the port if 8080 is occupied.
APP_PORT=8080

# Local HTTP development only. For production set production/true and HTTPS origins.
AUTH_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Public signup defaults to true in development and false in production.
# AUTH_PUBLIC_SIGNUP=false

# Set all three only if the default Docker subnet overlaps an existing network.
# The proxy IP must be inside the subnet and outside the dynamic range.
# QUEEZO_PROXY_SUBNET=172.31.252.0/28
# QUEEZO_PROXY_DYNAMIC_RANGE=172.31.252.8/29
# QUEEZO_PROXY_IP=172.31.252.2

# Optional: host Ollama for the Phase 1 flashcard distractor service.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_REQUEST_TIMEOUT_SECONDS=60
MCQ_PREPARATION_TIMEOUT_SECONDS=900
MCQ_MAX_PENDING_JOBS=16
MCQ_MAX_PENDING_PER_USER=3
